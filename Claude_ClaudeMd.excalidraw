      "version": 371,
      "versionNonce": 330978208,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791605726284,
      "created": 1791530913461,
      "link": null,
      "locked": false,
      "text": "2. Functional Requirements",
      "fontSize": 53.14285714285705,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Functional Requirements ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "aWm9K-9yxD_Ey1G73axbr",
      "type": "text",
      "x": 477.01190476190493,
      "y": 1699.1428571428582,
      "width": 1547.1428571428576,
      "height": 405,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4X",
      "roundness": null,
      "seed": 1826424599,
      "version": 1183,
      "versionNonce": 1518220896,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791605726284,
      "created": 1791530949189,
      "link": null,
      "locked": false,
      "text": "The system should:\n\n- Display a sidebar showing a list of past chats\n- Show a short, readable title for each chat\n- Automatically generate the title from the user's first message.\n- Allow users to click on any chat to open it.\n- Highlight the currently active chat\n- Add a new chat to the list after the first message is sent\n- Display chats in order from most recent to oldest.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The system should:\n\n- Display a sidebar showing a list of past chats\n- Show a short, readable title for each chat\n- Automatically generate the title from the user's first message.\n- Allow users to click on any chat to open it.\n- Highlight the currently active chat\n- Add a new chat to the list after the first message is sent\n- Display chats in order from most recent to oldest.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
