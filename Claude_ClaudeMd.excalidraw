      "boundElements": null,
      "updated": 1791605952565,
      "created": 1791605798634,
      "link": null,
      "locked": false,
      "text": "Project Context\n\n- A short description of the project so Claude immediately understands what it is building or\nmodifying\n\nExample:\n\nThis is a FastAPI backend for health-tracking application that stores patient BMI records\nand exposes CRUD APIs.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Project Context\n\n- A short description of the project so Claude immediately understands what it is building or modifying\n\nExample:\n\nThis is a FastAPI backend for health-tracking application that stores patient BMI records and exposes CRUD APIs.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "MvwN6oEAkX8ChNiERkrQx",
      "type": "text",
      "x": 337.72619047619065,
      "y": 1005.5714285714298,
      "width": 14.399993896484375,
      "height": 45,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ff8787",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
