      "seed": 1044600416,
      "version": 1802,
      "versionNonce": 1226834848,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791615317958,
      "created": 1791614956211,
      "link": null,
      "locked": false,
      "text": "Auto memory is a persistent directory where Claude records learnings , patterns , and insights\nas it works.\n\nWhen Claude discovers something about your project (\"oh, this application uses INR instead of\nUSD\"), it saves that to auto-memory. Next session, it already knows. No more repeating\nyourself.\n\nIt lives in ~/.claude/projects/<project-name>/memory/MEMORY.md\n\nOnly the first 200 lines of MEMORY.md load automatically.\n\nTo review or edit what Claude has saved, run /memory during any session.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Auto memory is a persistent directory where Claude records learnings , patterns , and insights as it works.\n\nWhen Claude discovers something about your project (\"oh, this application uses INR instead of USD\"), it saves that to auto-memory. Next session, it already knows. No more repeating yourself.\n\nIt lives in ~/.claude/projects/<project-name>/memory/MEMORY.md\n\nOnly the first 200 lines of MEMORY.md load automatically.\n\nTo review or edit what Claude has saved, run /memory during any session.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    }
  ],
