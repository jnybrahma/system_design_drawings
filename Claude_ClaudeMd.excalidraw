    {
      "id": "xFM9lWvcOBXv7AXMND9Sr",
      "type": "text",
      "x": 1778.0065467471172,
      "y": 11829.428571428578,
      "width": 779.9397583007812,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5b",
