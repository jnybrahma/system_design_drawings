      "updated": 1791606927549,
      "created": 1791606774624,
      "link": null,
      "locked": false,
      "text": "Critical rules\n\nHighlights critical warnings, edge cases, and things to avoid.\n\nExample:\n\n- Do not modify 'database.py' unless absolutely necessary.\n- Patient IDs are provided by the client; do not auto-generate UUIDs. ",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Critical rules\n\nHighlights critical warnings, edge cases, and things to avoid.\n\nExample:\n\n- Do not modify 'database.py' unless absolutely necessary.\n- Patient IDs are provided by the client; do not auto-generate UUIDs. ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
