      "version": 492,
      "versionNonce": 1665504669,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790728818467,
      "created": 1790727696405,
      "link": null,
      "locked": false,
      "text": "- POST : /v1/user/register + (login/logout/update)\n- GET : /v1/subscription/plans -> All subscription plans\n- POST : /v1/subscription {postBody: user metadata + subscriptionId}\n- GET : /v1/videos/search?q={name} -> List<videoId (partial)> : Pagination\n- GET : /v1/videos/{videoId} -> return the video metadata (json)\n- GET : /v1/videos/play/{videoId} -> start the video\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- POST : /v1/user/register + (login/logout/update)\n- GET : /v1/subscription/plans -> All subscription plans\n- POST : /v1/subscription {postBody: user metadata + subscriptionId}\n- GET : /v1/videos/search?q={name} -> List<videoId (partial)> : Pagination\n- GET : /v1/videos/{videoId} -> return the video metadata (json)\n- GET : /v1/videos/play/{videoId} -> start the video\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
