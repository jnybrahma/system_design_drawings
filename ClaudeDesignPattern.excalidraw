      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "WBQ6ClCLJ86cdhjuBy4uO",
      "type": "text",
      "x": 1815.4580412365144,
      "y": 2960.214285714286,
      "width": 800,
      "height": 90,
      "angle": 0,
