    {
      "id": "8QG2fK2CTBVSEZdHPPAB0",
      "type": "text",
      "x": 374.8690476190477,
      "y": 824.1428571428593,
      "width": 708.731689453125,
      "height": 270,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#228be6",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
