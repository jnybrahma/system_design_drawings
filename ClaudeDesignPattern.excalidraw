      "text": "The three principles to build by",
      "fontSize": 64.57142857142857,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The three principles to build by",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "DwPNPsqXOE_XLL9LHAYfH",
