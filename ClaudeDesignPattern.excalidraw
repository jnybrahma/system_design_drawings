      "updated": 1792648156949,
      "created": 1792647388710,
      "link": null,
      "locked": false,
      "text": "Workflow (Predictability)\n- Code controls the sequence of steps\n- Surprises are bugs\n- Predictability: same input, same path\n- Prompt chaining Routing Parallelization\n",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Workflow (Predictability)\n- Code controls the sequence of steps\n- Surprises are bugs\n- Predictability: same input, same path\n- Prompt chaining Routing Parallelization\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
