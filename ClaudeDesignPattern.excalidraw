    {
      "id": "oKbbA5h-IbiwoZQ6XmR6o",
      "type": "text",
      "x": 312.01190476190493,
      "y": 3452.714285714286,
      "width": 1068.571428571429,
      "height": 450,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#e03131",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9Z",
      "roundness": null,
      "seed": 794264428,
      "version": 463,
      "versionNonce": 1866487892,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792651817158,
      "created": 1792651509464,
      "link": null,
      "locked": false,
      "text": "1. Single Augmented LLM\n    - (for single query call with retrieval)\n2. Chaining / Routing\n    - (For fixed, nameable steps or distinct categories)\n3. Parallelization\n    - (For independent subtasks or multiple perspective\n4. Orchestrator-workers\n    - (For subtasks you cannot predict in advance)\n5. Evaluator-optimizer\n    - (When there are clear criteria and value in iteration) ",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Single Augmented LLM\n    - (for single query call with retrieval)\n2. Chaining / Routing\n    - (For fixed, nameable steps or distinct categories)\n3. Parallelization\n    - (For independent subtasks or multiple perspective\n4. Orchestrator-workers\n    - (For subtasks you cannot predict in advance)\n5. Evaluator-optimizer\n    - (When there are clear criteria and value in iteration) ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
