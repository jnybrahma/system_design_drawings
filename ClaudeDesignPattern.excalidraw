      "roundness": null,
      "seed": 1865979988,
      "version": 291,
      "versionNonce": 524600940,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "pCZC_RIKItLwk4iHY-WKE",
          "type": "arrow"
        }
      ],
      "updated": 1792648156949,
      "created": 1792647388710,
      "link": null,
      "locked": false,
      "text": "Workflow (Predictability)\n- Code controls the sequence of steps\n- Surprises are bugs\n- Predictability: same input, same path\n- Prompt chaining Routing Parallelization\n",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Workflow (Predictability)\n- Code controls the sequence of steps\n- Surprises are bugs\n- Predictability: same input, same path\n- Prompt chaining Routing Parallelization\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "CoWT-v1iOOdU8OFMzIbfe",
      "type": "text",
      "x": 1470.6894734700525,
      "y": 828.0714285714305,
      "width": 844.2857142857142,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#228be6",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
