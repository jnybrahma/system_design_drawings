      "version": 308,
      "versionNonce": 552786644,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792651403205,
      "created": 1792651227735,
      "link": null,
      "locked": false,
      "text": "Orchestrator-workers : Agent(Model Flow)\n- Parent query() delegating dynamically.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Orchestrator-workers : Agent(Model Flow)\n- Parent query() delegating dynamically.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "GAJIy74XPt6NhmGDC2lWG",
      "type": "text",
      "x": 1035.4580412365142,
      "y": 3168.7857142857147,
      "width": 800,
      "height": 90,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#e03131",
      "fillStyle": "solid",
