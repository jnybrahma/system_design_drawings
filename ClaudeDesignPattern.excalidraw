        }
      ],
      "updated": 1792648287659,
      "created": 1792647442850,
      "link": null,
      "locked": false,
      "text": "Agent (Flexibility)\n- Model controls the sequence at runtime.\n- Adapts to the input.\n- Flexibility: model adapts the path\n- Orchestrator - workers Full agent autonomy\n",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Agent (Flexibility)\n- Model controls the sequence at runtime.\n- Adapts to the input.\n- Flexibility: model adapts the path\n- Orchestrator - workers Full agent autonomy\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
