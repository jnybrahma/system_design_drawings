      "isDeleted": false,
      "boundElements": [],
      "updated": 1792651404588,
      "created": 1792651285142,
      "link": null,
      "locked": false,
      "text": "Evaluator-optimizer : Loop(Model Flow)\n- Reviewer subagent driving bunded iteration.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Evaluator-optimizer : Loop(Model Flow)\n- Reviewer subagent driving bunded iteration.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "MZaPymIu4nBE5iaRG_87c",
      "type": "text",
      "x": 273.4404761904766,
      "y": 3346.2857142857138,
      "width": 1495.7142857142856,
      "height": 80.71428571428571,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#228be6",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9X",
      "roundness": null,
      "seed": 887632724,
      "version": 523,
      "versionNonce": 927903596,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792651492745,
      "created": 1792651454053,
      "link": null,
      "locked": false,
      "text": "Choosing: match the pattern to the complexity",
      "fontSize": 64.57142857142857,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Choosing: match the pattern to the complexity",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "oKbbA5h-IbiwoZQ6XmR6o",
      "type": "text",
      "x": 312.01190476190493,
      "y": 3452.714285714286,
      "width": 1068.571428571429,
      "height": 450,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#e03131",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9Z",
      "roundness": null,
      "seed": 794264428,
      "version": 463,
      "versionNonce": 1866487892,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792651817158,
      "created": 1792651509464,
      "link": null,
      "locked": false,
      "text": "1. Single Augmented LLM\n    - (for single query call with retrieval)\n2. Chaining / Routing\n    - (For fixed, nameable steps or distinct categories)\n3. Parallelization\n    - (For independent subtasks or multiple perspective\n4. Orchestrator-workers\n    - (For subtasks you cannot predict in advance)\n5. Evaluator-optimizer\n    - (When there are clear criteria and value in iteration) ",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Single Augmented LLM\n    - (for single query call with retrieval)\n2. Chaining / Routing\n    - (For fixed, nameable steps or distinct categories)\n3. Parallelization\n    - (For independent subtasks or multiple perspective\n4. Orchestrator-workers\n    - (For subtasks you cannot predict in advance)\n5. Evaluator-optimizer\n    - (When there are clear criteria and value in iteration) ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Q_o64-vJY23JZpm2R80Qp",
      "type": "text",
      "x": 285.5833333333336,
      "y": 3979.142857142856,
      "width": 1058.5714285714282,
      "height": 80.71428571428571,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#228be6",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9a",
      "roundness": null,
      "seed": 515346004,
      "version": 661,
