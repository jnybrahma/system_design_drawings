      "updated": 1794912109670,
      "created": 1794912053745,
      "link": null,
      "locked": false,
      "text": "The three (3) principles to build by;",
      "fontSize": 64.57142857142857,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The three (3) principles to build by;",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "BS8zQy5IK9c_GYD0-rcNv",
      "type": "text",
      "x": 208.63241940452986,
      "y": 13204.666666666673,
      "width": 650.9876708984375,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fa5252",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bC1",
      "roundness": null,
      "seed": 2126274940,
      "version": 1058,
      "versionNonce": 869332420,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794912188380,
      "created": 1794912101596,
      "link": null,
      "locked": false,
      "text": "Maintain Simplicity:\n- Start with the simplest thing.\nProve that complexity earns its keep\nbefore you add it.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Maintain Simplicity:\n- Start with the simplest thing.\nProve that complexity earns its keep\nbefore you add it.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "bkhGpMiVlOiiCMbIGhIuz",
      "type": "text",
      "x": 959.6631760370169,
      "y": 13192.166666666677,
      "width": 663.01171875,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fa5252",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bC2",
      "roundness": null,
      "seed": 873853892,
      "version": 1294,
      "versionNonce": 1388837628,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794912327697,
      "created": 1794912194689,
      "link": null,
      "locked": false,
      "text": "Prioritize Transparency:\n- Make the agent's reasoning visible.\nRely on streaming outputs and traces\ninstead of hidden logic.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Prioritize Transparency:\n- Make the agent's reasoning visible.\nRely on streaming outputs and traces\ninstead of hidden logic.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "ZyAKkV9YucOFZ-2W6imuv",
      "type": "text",
      "x": 1748.6511521112361,
      "y": 13192.166666666675,
      "width": 705.851806640625,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fa5252",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bC3",
      "roundness": null,
      "seed": 758102396,
      "version": 1540,
      "versionNonce": 1039587908,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794912566341,
      "created": 1794912324565,
      "link": null,
      "locked": false,
      "text": "Craft the interface:\n- Good tool descriptions are like\ndocstrings for AI. A tools\nname, description, and parameters are \nhow the model understands its universe.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Craft the interface:\n- Good tool descriptions are like\ndocstrings for AI. A tools\nname, description, and parameters are \nhow the model understands its universe.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    }
