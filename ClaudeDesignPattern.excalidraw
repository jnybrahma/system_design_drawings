    {
      "id": "ecBsoQt76ncBSSADY7diC",
      "type": "text",
      "x": -16.949211483909266,
      "y": 9318.904761904776,
      "width": 657.287841796875,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fa5252",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAn",
      "roundness": null,
      "seed": 1588474308,
      "version": 774,
      "versionNonce": 1494496324,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794909282057,
      "created": 1794909100607,
      "link": null,
      "locked": false,
      "text": "The Shift\n- Subtasks are no longer pre-defined.\nThe model decides how many workers\nto spawn and what they do based on\nruntime input.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Shift\n- Subtasks are no longer pre-defined.\nThe model decides how many workers\nto spawn and what they do based on\nruntime input.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "5sjj66SsaRmqXlW7VvwxE",
      "type": "text",
      "x": 697.7891678583064,
      "y": 9326.047619047633,
      "width": 742.4636840820312,
      "height": 225,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#fa5252",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAo",
      "roundness": null,
      "seed": 17520964,
      "version": 854,
      "versionNonce": 858895812,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794909351869,
      "created": 1794909100607,
      "link": null,
      "locked": false,
      "text": "SDK Implementation\n- A parent query() with the Agent tool\ndelegating dynamically. Hand-wiring dynamic\ndecomposition is exactly the painful loop\nthe SDK was built to avoid. ",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SDK Implementation\n- A parent query() with the Agent tool\ndelegating dynamically. Hand-wiring dynamic\ndecomposition is exactly the painful loop\nthe SDK was built to avoid. ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "U8B5n8XfzOJcgM65M7xQU",
      "type": "text",
      "x": 1496.0817682175418,
      "y": 9336.047619047635,
      "width": 757.0076904296875,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#fa5252",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAp",
      "roundness": null,
      "seed": 1012371652,
      "version": 935,
      "versionNonce": 2046865916,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794909460199,
      "created": 1794909100608,
      "link": null,
      "locked": false,
      "text": "Buggy-Shop Example\n- 'Make the test suite pass' spawns\none worker per failing module automatically.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Buggy-Shop Example\n- 'Make the test suite pass' spawns\none worker per failing module automatically.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
