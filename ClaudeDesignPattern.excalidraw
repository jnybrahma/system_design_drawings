      "isDeleted": false,
      "boundElements": [],
      "updated": 1792651890723,
      "created": 1792651861675,
      "link": null,
      "locked": false,
      "text": "The three principles to build by",
      "fontSize": 64.57142857142857,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The three principles to build by",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "DwPNPsqXOE_XLL9LHAYfH",
      "type": "text",
      "x": 322.01190476190493,
      "y": 4094.142857142857,
      "width": 1211.4285714285718,
