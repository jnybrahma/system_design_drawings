      "originalText": "Parallelization : Workflow (Code Flow)\n- Concurrent subagents or read-only tools.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "5o8Y153qeGKvjaqDsuUDt",
      "type": "text",
      "x": 256.8866126650857,
      "y": 3165.928571428572,
      "width": 741.7077026367188,
