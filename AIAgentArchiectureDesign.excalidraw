    {
      "id": "q2nogc4SDygiyxAS2Y0LM",
      "type": "text",
      "x": 479.15476190476204,
      "y": 1142.7142857142871,
      "width": 555.8397216796875,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#1971c2",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAg",
      "roundness": null,
      "seed": 200948705,
      "version": 205,
      "versionNonce": 516125092,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794092521180,
      "created": 1793958479782,
      "link": null,
      "locked": false,
      "text": "1. Tool Calling = Function calling\n2. Planning architecture\n3. Memory architecture\n4. Multi-agent architecture\n5. Human approval\n6. Sandboxed execution\n7. Evaluation",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Tool Calling = Function calling\n2. Planning architecture\n3. Memory architecture\n4. Multi-agent architecture\n5. Human approval\n6. Sandboxed execution\n7. Evaluation",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "BYBmhp8SvbFQsWEfhvRBN",
      "type": "text",
      "x": 1306.2976190476193,
      "y": 1099.8571428571445,
      "width": 1064.2857142857154,
      "height": 540,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#1971c2",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAh",
      "roundness": null,
      "seed": 1249875073,
      "version": 511,
      "versionNonce": 2765468,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794092523131,
      "created": 1793959467261,
      "link": null,
      "locked": false,
      "text": "1. Start Small\n    - the smallest system that solves the task\n2. Add planning\n    - when the sequence is genuinely dynamic\n3. Add memory\n    - when information must carry across sessions\n4. Add more agents\n    - when responsibilities divide clearly\n5. Add approvals and isolation\n    - when the agent can cause greater consequences\n6. Build evaluations\n    - to know if changes make it better or worse",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Start Small\n    - the smallest system that solves the task\n2. Add planning\n    - when the sequence is genuinely dynamic\n3. Add memory\n    - when information must carry across sessions\n4. Add more agents\n    - when responsibilities divide clearly\n5. Add approvals and isolation\n    - when the agent can cause greater consequences\n6. Build evaluations\n    - to know if changes make it better or worse",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "RWaNJ6OQBIMWXqapPyZJm",
      "type": "text",
      "x": 466.29761904761926,
      "y": 1739.8571428571445,
      "width": 610.9197387695312,
      "height": 270,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#1971c2",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAj",
      "roundness": null,
      "seed": 1584252974,
      "version": 223,
      "versionNonce": 776627054,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794045688027,
      "created": 1794045475097,
      "link": null,
      "locked": false,
      "text": "Agent has Five Core Subsystems :-\n- Perception\n- Reasoning\n- Action\n- Learning\n- Communication",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Agent has Five Core Subsystems :-\n- Perception\n- Reasoning\n- Action\n- Learning\n- Communication",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "pzEs4lWEZXj2zxgKdzFoA",
      "type": "text",
      "x": 479.15476190476215,
      "y": 2045.5714285714303,
      "width": 1552.857142857143,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#1971c2",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAk",
      "roundness": null,
      "seed": 2063105710,
      "version": 72,
      "versionNonce": 914564654,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794045936445,
      "created": 1794045882331,
      "link": null,
      "locked": false,
      "text": "An AI agentic system learns by using experience, feedback, memory, and evaluation to\nimprove how it performs tasks over time.\nAn AI agent does not necessarily learn by changing its underlying AI model. It can\nimprove its behaviour through memory, instructions, feedback, and adaptation without\nretraining the model.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An AI agentic system learns by using experience, feedback, memory, and evaluation to improve how it performs tasks over time.\nAn AI agent does not necessarily learn by changing its underlying AI model. It can improve its behaviour through memory, instructions, feedback, and adaptation without retraining the model.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
