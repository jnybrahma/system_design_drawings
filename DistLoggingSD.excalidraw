      "locked": false,
      "text": "3. Identify Core Entity\n- LogEvent (the actual Log)\n- IngestionJob\n- Source/Agent",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
