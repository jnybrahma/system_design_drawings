      "version": 603,
      "versionNonce": 548891361,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791018541467,
      "created": 1790905691324,
      "link": null,
      "locked": false,
      "text": "4. API Design\n- GET: /api/dashboard/search?metric={metric}&\nfrom={time}&to={time}&source={src}",
      "fontSize": 38.285714285714214,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
