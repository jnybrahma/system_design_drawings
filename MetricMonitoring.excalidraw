    },
    {
      "id": "LqUHwmohxg6WWJ6zyHHLc",
      "type": "text",
      "x": 332.53571428571445,
      "y": 453.92857142857133,
      "width": 1567.9999999999995,
      "height": 70,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2",
      "roundness": null,
      "seed": 1988639792,
      "version": 791,
      "versionNonce": 1922109294,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790933446363,
      "created": 1790905150192,
      "link": null,
      "locked": false,
      "text": "- Monitoring the performance of servers hosted on-premises and resources belong to servers \n- Alerting system to send notification",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Monitoring the performance of servers hosted on-premises and resources belong to servers \n- Alerting system to send notification",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "lEvlE9UEaXsWya5wmKfxs",
      "type": "text",
      "x": 325.0000000000001,
      "y": 573.892857142857,
      "width": 737.927734375,
      "height": 270,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 1914127408,
      "version": 782,
      "versionNonce": 796377217,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791016752809,
      "created": 1790905228772,
      "link": null,
      "locked": false,
      "text": "1. Functional Requirements\n-  Collect data/event (Cpu, Ram, disk etc)\n-  Store information\n- Dashboard UI\n- Creating the Alerts\n- Create update the rules",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Functional Requirements\n-  Collect data/event (Cpu, Ram, disk etc)\n-  Store information\n- Dashboard UI\n- Creating the Alerts\n- Create update the rules",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "sLy35QGaBT1eBtu_DSuVY",
      "type": "text",
      "x": 1199.7069145081532,
      "y": 579.0317460317458,
      "width": 681.4285714285706,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 2110042672,
      "version": 993,
      "versionNonce": 1266432655,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791018553467,
      "created": 1790905245089,
      "link": null,
      "locked": false,
      "text": "2. Non- Functional Requirements\n- Scale: 10K metrics/msec\n- CAP Theorem : High availability >>\nconsistency\n- Latency : Low latency on loading the\ndashboard",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Non- Functional Requirements\n- Scale: 10K metrics/msec\n- CAP Theorem : High availability >> consistency\n- Latency : Low latency on loading the dashboard",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "F5RZpk9KIpmnGmbs6ilOz",
      "type": "text",
      "x": 312.7619047619046,
      "y": 920.563492063492,
      "width": 487.14874267578125,
      "height": 182.8571428571425,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a6",
      "roundness": null,
      "seed": 1654900432,
      "version": 397,
      "versionNonce": 1333216065,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791016754975,
      "created": 1790905555007,
      "link": null,
      "locked": false,
      "text": "3. Identify Core Entity\n- metric :  cpu , ram\n- source : host , ip address\n- timestamp : date/time",
      "fontSize": 36.5714285714285,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. Identify Core Entity\n- metric :  cpu , ram\n- source : host , ip address\n- timestamp : date/time",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "twfEgz-9jDD6u2xZZOBok",
      "type": "text",
      "x": 1129.6825396825393,
      "y": 920.9603174603182,
      "width": 990.0000000000003,
      "height": 143.5714285714283,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
