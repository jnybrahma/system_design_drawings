      "link": null,
      "locked": false,
      "text": "- A job schedular is a program that automatically schedules and executes jobs at specified times or intervals.\n- Its is used to automate repetitive tasks, run scheduled maintenance, or execute batch processes near real time",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- A job schedular is a program that automatically schedules and executes jobs at specified times or intervals.\n- Its is used to automate repetitive tasks, run scheduled maintenance, or execute batch processes near real time",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
