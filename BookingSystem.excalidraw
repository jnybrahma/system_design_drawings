      "text": "API Gateway \n               + \nLoad Balancer\n- authentication\n& Authorization\n- routing\n- rate limiting\n- round robin",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "WOeQtp0AUtWmi4RPv9a7N",
      "originalText": "API Gateway \n               + \nLoad Balancer\n- authentication & Authorization\n- routing\n- rate limiting\n- round robin",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
