  "elements": [
    {
      "id": "Lt6hX8mJjCl2tfbef3yMA",
      "type": "text",
      "x": 377,
      "y": 174.5,
      "width": 802.1893408203124,
      "height": 66,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 1803661091,
      "version": 219,
      "versionNonce": 1637838476,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790586084738,
      "created": 1790584042613,
      "link": null,
      "locked": false,
      "text": "Design  an hotel booking systems\n- Online platform that allows users to search and book rooms based on location, date and availability\n ",
      "fontSize": 17.599999999999994,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Design  an hotel booking systems\n- Online platform that allows users to search and book rooms based on location, date and availability\n ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "4ISJ15uNQc_A176zz_sKb",
      "type": "text",
      "x": 363,
      "y": 252.5,
      "width": 407.33978271484375,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aH",
      "roundness": null,
      "seed": 1411325869,
      "version": 277,
      "versionNonce": 590351796,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790585348204,
      "created": 1790584165506,
      "link": null,
      "locked": false,
      "text": "1. Functional requirement\n- Create user account\n- Search hotels and location\n- book room on hotel based on availability\n- make payment and confirm booking\n- view past booking in user profile",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Functional requirement\n- Create user account\n- Search hotels and location\n- book room on hotel based on availability\n- make payment and confirm booking\n- view past booking in user profile",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Niho-4YBK-gmtpch_ayMb",
      "type": "text",
      "x": 974,
      "y": 250.5,
      "width": 444.65972900390625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aI",
      "roundness": null,
      "seed": 773518989,
      "version": 239,
      "versionNonce": 1935371267,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790584551124,
      "created": 1790584322380,
      "link": null,
      "locked": false,
      "text": "2. Non- Functional requirement\n- Scale - 50M users and 1 M hotels\n- CAP theorem: Highly available, consistent no\ntwo user can book same rooms on same date ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Non- Functional requirement\n- Scale - 50M users and 1 M hotels\n- CAP theorem: Highly available, consistent no\ntwo user can book same rooms on same date ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "BRsUluejqFuEQ_1O_KvkK",
      "type": "text",
      "x": 361,
      "y": 424.5,
      "width": 230.75987243652344,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aJ",
      "roundness": null,
      "seed": 1361741421,
      "version": 68,
      "versionNonce": 780387491,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790584477331,
      "created": 1790584444533,
      "link": null,
      "locked": false,
      "text": "2. Identity Core Entity\n- User\n- Hotel\n- Room\n- Booking ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Identity Core Entity\n- User\n- Hotel\n- Room\n- Booking ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "W5d83pd6K6RMbh1ogtTuH",
      "type": "text",
      "x": 716,
      "y": 417.5,
      "width": 1034.279296875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aK",
      "roundness": null,
      "seed": 1583737389,
      "version": 537,
      "versionNonce": 1422628236,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790585270952,
      "created": 1790584502336,
      "link": null,
      "locked": false,
      "text": "3. API Design\n- POST : /v1/user/registry {postBody: userMetaData} + (login/logout/update)\n- GET : /v1/hotels/search?q={name}&l={location} -> List<HotelId>(Partial)-Pagination\n- GET : /v1/hotels/{hotelId}/{date} -> MetaData of hotel (available rooms + review +...)\n- POST : /v1/booking {postBody: hotelId , roomId, date} -> Return booking Id after successful payment\n- GET :/v1/bookings/{userId} - List of all booking.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. API Design\n- POST : /v1/user/registry {postBody: userMetaData} + (login/logout/update)\n- GET : /v1/hotels/search?q={name}&l={location} -> List<HotelId>(Partial)-Pagination\n- GET : /v1/hotels/{hotelId}/{date} -> MetaData of hotel (available rooms + review +...)\n- POST : /v1/booking {postBody: hotelId , roomId, date} -> Return booking Id after successful payment\n- GET :/v1/bookings/{userId} - List of all booking.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
