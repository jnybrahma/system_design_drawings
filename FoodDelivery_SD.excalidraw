      "boundElements": null,
      "updated": 1790675417434,
      "created": 1790670960570,
      "link": null,
      "locked": false,
      "text": "Actors;\n- Users\n- Restaurants\n- Delivery partner",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Actors;\n- Users\n- Restaurants\n- Delivery partner",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "HqWoD107e-R8-KB-G4geS",
      "type": "text",
      "x": -49.81060271561148,
      "y": 842.249369730644,
      "width": 242.2598114013672,
      "height": 175,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4J",
      "roundness": null,
      "seed": 1983410544,
      "version": 240,
      "versionNonce": 1385536912,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790675417434,
      "created": 1790672006567,
      "link": null,
      "locked": false,
      "text": "3. Identify Core Entity\n-  Users\n- Restaurants\n- FoodMenu\n- Delivery Agent/Partner\n- Payment\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. Identify Core Entity\n-  Users\n- Restaurants\n- FoodMenu\n- Delivery Agent/Partner\n- Payment\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "9qonms6ymOv0As8SaXV-q",
      "type": "text",
      "x": -43.81060271561148,
      "y": 1040.249369730644,
      "width": 1081.67919921875,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4K",
      "roundness": null,
      "seed": 101501840,
      "version": 962,
      "versionNonce": 21545840,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790675417434,
      "created": 1790672111395,
      "link": null,
      "locked": false,
      "text": "4. API Design\n- POST : /v1/user/register {PostBody: userMetaData} + (login/logout/update)\n- GET : /v1/restaurants/nearby?lat={lat}&long={long}&rad={rad} -> List<RestaurantId (Partial) >: Pagination\n- GET :/v1/restaurants/search?title={title}&menuItem={item} -> List<RestaurantId (Partial) > : Pagination\n- GET :/v1/restaurants/{restId} -> Restaurant Metadata\n- GET :/v1/restaurants/{restId}/menu -> List of foodItimes available\n- POST :/v1/cart/items {PostBody: itemId + qty  + restId} + (update/delete) : returns cartId\n- POST :/v1/orders {PostBody: orderId} : return orderId\n- POST: /v1/payment {PostBody: paymentMetaData + orderId} : returns paymentID\n- GET :/v1/delivery/{orderId}/tracking",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. API Design\n- POST : /v1/user/register {PostBody: userMetaData} + (login/logout/update)\n- GET : /v1/restaurants/nearby?lat={lat}&long={long}&rad={rad} -> List<RestaurantId (Partial) >: Pagination\n- GET :/v1/restaurants/search?title={title}&menuItem={item} -> List<RestaurantId (Partial) > : Pagination\n- GET :/v1/restaurants/{restId} -> Restaurant Metadata\n- GET :/v1/restaurants/{restId}/menu -> List of foodItimes available\n- POST :/v1/cart/items {PostBody: itemId + qty  + restId} + (update/delete) : returns cartId\n- POST :/v1/orders {PostBody: orderId} : return orderId\n- POST: /v1/payment {PostBody: paymentMetaData + orderId} : returns paymentID\n- GET :/v1/delivery/{orderId}/tracking",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
