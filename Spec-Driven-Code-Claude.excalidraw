      "created": 1791531352313,
      "link": null,
      "locked": false,
      "text": "EXPECTED SYSTEM BEHAVIOR\n- Open the selected chat in the main chat area\n- Display the full conversation\n- Show message in the order they were\noriginally sent\n- Highlight the selected chat in the sidebar",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "EXPECTED SYSTEM BEHAVIOR\n- Open the selected chat in the main chat area\n- Display the full conversation\n- Show message in the order they were originally sent\n- Highlight the selected chat in the sidebar",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
