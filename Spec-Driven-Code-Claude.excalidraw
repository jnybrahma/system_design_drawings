      "version": 1182,
      "versionNonce": 1050241049,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791531207695,
      "created": 1791530949189,
      "link": null,
      "locked": false,
      "text": "The system should:\n\n- Display a sidebar showing a list of past chats\n- Show a short, readable title for each chat\n- Automatically generate the title from the user's first message.\n- Allow users to click on any chat to open it.\n- Highlight the currently active chat\n- Add a new chat to the list after the first message is sent\n- Display chats in order from most recent to oldest.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The system should:\n\n- Display a sidebar showing a list of past chats\n- Show a short, readable title for each chat\n- Automatically generate the title from the user's first message.\n- Allow users to click on any chat to open it.\n- Highlight the currently active chat\n- Add a new chat to the list after the first message is sent\n- Display chats in order from most recent to oldest.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
