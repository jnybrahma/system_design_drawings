      "versionNonce": 662857753,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791530394081,
      "created": 1790905245089,
      "link": null,
      "locked": false,
      "text": "- Problem Statement\n- Functional Requirements\n- API contracts (inputs, outputs, data shapes)\n- Constraints\n- Edge cases and error handling\n- Acceptance criteria",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Problem Statement\n- Functional Requirements\n- API contracts (inputs, outputs, data shapes)\n- Constraints\n- Edge cases and error handling\n- Acceptance criteria",
      "autoResize": false,
