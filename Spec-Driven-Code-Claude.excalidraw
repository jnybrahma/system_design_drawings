    {
      "id": "I5bNqKesB2tSSo3rqPMkn",
      "type": "text",
      "x": 473.4404761904765,
      "y": 8731.857142857149,
      "width": 1387.7181309291293,
      "height": 450,
      "angle": 0,
      "strokeColor": "#2f9e44",
