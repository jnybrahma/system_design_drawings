    {
      "id": "LqUHwmohxg6WWJ6zyHHLc",
      "type": "text",
      "x": 389.6785714285717,
      "y": 415.3571428571427,
      "width": 2015.1428571428569,
      "height": 135,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2",
      "roundness": null,
      "seed": 1988639792,
      "version": 1252,
      "versionNonce": 395152857,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791530477226,
      "created": 1790905150192,
      "link": null,
      "locked": false,
      "text": "-Spec driven development (SDD) is a software development approach where a detailed specification\ndocument is written before any code is written\n- The spec acts as the single source of truth for what the system should do, and all development flows from it.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-Spec driven development (SDD) is a software development approach where a detailed specification\ndocument is written before any code is written\n- The spec acts as the single source of truth for what the system should do, and all development flows from it.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "lEvlE9UEaXsWya5wmKfxs",
      "type": "text",
      "x": 325.0000000000001,
      "y": 573.892857142857,
      "width": 737.927734375,
      "height": 270,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 1914127408,
      "version": 783,
      "versionNonce": 966868151,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791530309779,
      "created": 1790905228772,
      "link": null,
      "locked": false,
      "text": "1. Functional Requirements\n-  Collect data/event (Cpu, Ram, disk etc)\n-  Store information\n- Dashboard UI\n- Creating the Alerts\n- Create update the rules",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Functional Requirements\n-  Collect data/event (Cpu, Ram, disk etc)\n-  Store information\n- Dashboard UI\n- Creating the Alerts\n- Create update the rules",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "sLy35QGaBT1eBtu_DSuVY",
      "type": "text",
      "x": 453.99262879386754,
      "y": 590.4603174603171,
      "width": 941.4285714285705,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
