      "created": 1790906774955,
      "link": null,
      "locked": false,
      "text": "1. Problem Statement",
      "fontSize": 53.14285714285705,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Problem Statement",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "YlplK2hyXmbACZBR_vU4c",
      "type": "text",
      "x": 509.15476190476227,
      "y": 1192.714285714287,
      "width": 1547.1428571428576,
      "height": 360,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3T",
      "roundness": null,
      "seed": 431660257,
      "version": 658,
      "versionNonce": 1628343161,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791530978415,
      "created": 1791016953378,
      "link": null,
      "locked": false,
      "text": "As users interact with the application, they create multiple conversations over time.\nHowever, there is currently no easy way to revisit or continue past chats.\nThis makes of difficult for users to:\n\n- Find the previous discussions\n- Resume earlier conversations\n- Manage multiple chat threads\nSolution: This feature introduces a chat history sidebar to solve this proble.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "As users interact with the application, they create multiple conversations over time. However, there is currently no easy way to revisit or continue past chats.\nThis makes of difficult for users to:\n\n- Find the previous discussions\n- Resume earlier conversations\n- Manage multiple chat threads\nSolution: This feature introduces a chat history sidebar to solve this proble.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "gDwpVjEP0OV-jnxwNAakm",
      "type": "text",
      "x": 461.70578231292603,
      "y": 1597.7142857142867,
      "width": 714.8979591836725,
      "height": 66.42857142857132,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
