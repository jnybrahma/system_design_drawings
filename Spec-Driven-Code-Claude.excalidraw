    {
      "id": "tqTfqA9RqWAFPaxLpib8S",
      "type": "text",
      "x": 460.58333333333354,
      "y": 7839.857142857146,
      "width": 1615.7142857142858,
      "height": 405,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#40c057",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5N",
      "roundness": null,
      "seed": 685939833,
      "version": 380,
      "versionNonce": 774308279,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791537412453,
      "created": 1791537204679,
      "link": null,
      "locked": false,
      "text": "A. Load Sidebar\n- Triggered on app open. Requests summaries sorted by updated_at DESC.\n\nB. Open Chat\n- Triggered by click. Requests full chat + messages ordered by created_at ASC.\n\nC. Title Generation\n- Title are generated from the first user message, truncated if necessary.\n",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A. Load Sidebar\n- Triggered on app open. Requests summaries sorted by updated_at DESC.\n\nB. Open Chat\n- Triggered by click. Requests full chat + messages ordered by created_at ASC.\n\nC. Title Generation\n- Title are generated from the first user message, truncated if necessary.\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
