    {
      "id": "Bzz9Kp-ZX-1riayD1VJXS",
      "type": "text",
      "x": 444.01587301587296,
      "y": 1115.9285714285716,
      "width": 714.8979591836725,
      "height": 66.42857142857129,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
