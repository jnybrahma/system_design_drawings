      "text": "6. Acceptance Criteria",
      "fontSize": 53.14285714285705,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "6. Acceptance Criteria",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "lqi0_k3K498keKGZqNtz4",
      "type": "text",
      "x": 474.8690476190478,
      "y": 3717,
      "width": 891.4285714285716,
      "height": 315,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4o",
      "roundness": null,
      "seed": 985866807,
      "version": 1379,
      "versionNonce": 1936986041,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791532381566,
      "created": 1791532220403,
      "link": null,
      "locked": false,
      "text": "This feature is considered complete if;\n\n- Users can see a list of their past chats\n- The correct conversation is displayed every time\n- New chats appear automatically after first use\n- Empty and error states are handled properly\n",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This feature is considered complete if;\n\n- Users can see a list of their past chats\n- The correct conversation is displayed every time\n- New chats appear automatically after first use\n- Empty and error states are handled properly\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "EBziSgr9cjnnZl7PfmJDo",
      "type": "text",
      "x": 1420.5833333333337,
      "y": 3809.142857142858,
      "width": 891.4285714285716,
      "height": 270,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4p",
      "roundness": null,
      "seed": 396959321,
      "version": 1879,
      "versionNonce": 232733177,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791532549688,
      "created": 1791532384332,
      "link": null,
      "locked": false,
      "text": "- Users can click and reopen any chat\n- The active chat is clearly highlighted\n- Chats are ordered from most recent to oldest\n- Long titles are displayed nearly without breaking\nthe layout\n",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Users can click and reopen any chat\n- The active chat is clearly highlighted\n- Chats are ordered from most recent to oldest\n- Long titles are displayed nearly without breaking the layout\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
