    {
      "id": "itkROgKbEUa6usLVfzOzw",
      "type": "text",
      "x": 413.4404761904764,
      "y": 4821.285714285712,
      "width": 1385.7142857142856,
      "height": 90,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#40c057",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5B",
      "roundness": null,
      "seed": 1684571575,
      "version": 209,
      "versionNonce": 897722361,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791535786713,
      "created": 1791535712113,
      "link": null,
      "locked": false,
      "text": "Technical specification for implementing a scalable, real-time chat history\nsidebar with React, FastAPI, and PostgreSQL",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Technical specification for implementing a scalable, real-time chat history sidebar with React, FastAPI, and PostgreSQL",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "6OaejCDgZFawNaDwvCjix",
      "type": "text",
      "x": 409.56292517006887,
      "y": 4951.999999999998,
      "width": 354.8979591836723,
      "height": 66.42857142857132,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5C",
      "roundness": null,
      "seed": 749069177,
      "version": 1064,
      "versionNonce": 2054011223,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791535963936,
      "created": 1791535791791,
      "link": null,
      "locked": false,
      "text": "1. Objective",
      "fontSize": 53.14285714285705,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Objective",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "ln7W1soS8p2ZxL1Xve3BQ",
      "type": "text",
      "x": 403.4404761904765,
      "y": 5075.928571428571,
      "width": 1084.2857142857144,
      "height": 270,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#40c057",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5D",
      "roundness": null,
      "seed": 138898199,
      "version": 524,
      "versionNonce": 1368304119,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791535947854,
      "created": 1791535820681,
      "link": null,
      "locked": false,
      "text": "Implement a chat history sidebar that allows users to:\n- View previous chats\n- Reopen any chat\n- Identify the currently active chat\n- Keep chats ordered by recent activity\n- Continue conversations seamlessly.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Implement a chat history sidebar that allows users to:\n- View previous chats\n- Reopen any chat\n- Identify the currently active chat\n- Keep chats ordered by recent activity\n- Continue conversations seamlessly.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "e_6F-j81yC9nJY-OpPaWi",
      "type": "text",
      "x": 407.4200680272114,
      "y": 5413.428571428571,
      "width": 443.4693877551008,
      "height": 66.42857142857132,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5E",
      "roundness": null,
      "seed": 1779074231,
      "version": 1135,
      "versionNonce": 770750073,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791535987393,
      "created": 1791535967114,
      "link": null,
      "locked": false,
      "text": "2. Tech Stack",
      "fontSize": 53.14285714285705,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Tech Stack",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "urBmu6sHah8OIiHBt9e7u",
      "type": "text",
      "x": 390.27721088435476,
      "y": 5881.999999999999,
      "width": 780.6122448979579,
      "height": 66.42857142857132,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5F",
      "roundness": null,
      "seed": 1685252919,
      "version": 1259,
      "versionNonce": 997421303,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791536027463,
      "created": 1791535995162,
      "link": null,
      "locked": false,
      "text": "3. High-Level Architecture",
      "fontSize": 53.14285714285705,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. High-Level Architecture",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "13IeuPygJwnN0iRZXvoo4",
      "type": "text",
      "x": 437.01190476190516,
      "y": 5517.357142857142,
      "width": 1465.7142857142858,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#40c057",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5G",
      "roundness": null,
      "seed": 606145111,
      "version": 970,
      "versionNonce": 425553239,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791536173064,
      "created": 1791536024710,
      "link": null,
      "locked": false,
      "text": "Why this stack?\n- React is excellent for dynamic UI such as chat sidebars.\n- FastAPI works well for API-based high-concurrency chat systems.\n- Relational DBs are a natural fit because chats and messages have a clear 1-to-\nmany relationship\n",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why this stack?\n- React is excellent for dynamic UI such as chat sidebars.\n- FastAPI works well for API-based high-concurrency chat systems.\n- Relational DBs are a natural fit because chats and messages have a clear 1-to-many relationship\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "vNxEjPHKd3Rwio71R6Cg1",
      "type": "text",
      "x": 405.5833333333336,
      "y": 5987.357142857143,
      "width": 1247.1428571428569,
      "height": 675,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#40c057",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5H",
      "roundness": null,
      "seed": 1648857657,
      "version": 997,
      "versionNonce": 1387434295,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791536488507,
      "created": 1791536188791,
      "link": null,
      "locked": false,
      "text": "The feature is divided into three distinct layers of responsibility: \nA. Frontend (React)\n- Render sidebar & window\n- Track active chat\n- Show loading/error states\n\nB. Backend (FastAPI)\n- Return chat summaries\n- Return full conversations\n- Create/append messages\n\nC. Databases\n- Stores chats & messages\n- Maintain relationships\n- Support ordered retrieval",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The feature is divided into three distinct layers of responsibility: \nA. Frontend (React)\n- Render sidebar & window\n- Track active chat\n- Show loading/error states\n\nB. Backend (FastAPI)\n- Return chat summaries\n- Return full conversations\n- Create/append messages\n\nC. Databases\n- Stores chats & messages\n- Maintain relationships\n- Support ordered retrieval",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "c1LAQAXfefuvb67VfAUyo",
      "type": "text",
      "x": 420.2772108843546,
      "y": 6759.142857142856,
      "width": 780.6122448979579,
      "height": 66.42857142857132,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5I",
      "roundness": null,
      "seed": 566003417,
      "version": 1371,
      "versionNonce": 653441303,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791536447271,
      "created": 1791536308514,
      "link": null,
      "locked": false,
      "text": "4. Data Model",
      "fontSize": 53.14285714285705,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. Data Model",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
