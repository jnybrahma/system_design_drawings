      "text": "- Show message: \"No chat history yet\"\n- Show message: \"Chat could not be opened\n- Use only the first part as the title\n- Allowed (each chat is still unique)\n- Show message: \"Unable to load chat history. please try again\"\n- Sidebar should remain scrollable",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Show message: \"No chat history yet\"\n- Show message: \"Chat could not be opened\n- Use only the first part as the title\n- Allowed (each chat is still unique)\n- Show message: \"Unable to load chat history. please try again\"\n- Sidebar should remain scrollable",
      "autoResize": false,
