      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "_MuuhDBKwLPdtECq25CrU",
      "type": "text",
      "x": 429.15476190476227,
      "y": 7141.642857142858,
      "width": 1651.4285714285713,
      "height": 540,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#40c057",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5L",
      "roundness": null,
      "seed": 2016144793,
      "version": 1239,
      "versionNonce": 1751075545,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791537072443,
      "created": 1791536686094,
      "link": null,
      "locked": false,
      "text": "Decision 1: Store chats and messages separately\nWhy: A chat contains metadata , while messages vary in number. Separation makes retrieval\nand ordering efficient.\n\nDecision 2: Use Updated at to sort chats\nWhy: The sidebar should surface most recently active chats first. Updating this timestamp\non new messages naturally handle sorting.\n\nDecision 3: Fetch summaries for sidebar\nWhy: Sidebar load times must be fast. Fetching thousands of message contents upfront\ndestroy performance\n",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Decision 1: Store chats and messages separately\nWhy: A chat contains metadata , while messages vary in number. Separation makes retrieval and ordering efficient.\n\nDecision 2: Use Updated at to sort chats\nWhy: The sidebar should surface most recently active chats first. Updating this timestamp on new messages naturally handle sorting.\n\nDecision 3: Fetch summaries for sidebar\nWhy: Sidebar load times must be fast. Fetching thousands of message contents upfront destroy performance\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
