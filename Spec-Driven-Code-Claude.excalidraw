      "type": "text",
      "x": 477.01190476190493,
      "y": 1699.1428571428582,
      "width": 1547.1428571428576,
      "height": 405,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
