      "link": null,
      "locked": false,
      "text": "2. Non-Functional Requirements;\n- Scalable\n- Reliable\n- Modular\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
