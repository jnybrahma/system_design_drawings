    {
      "id": "smuuymnDB4ptCzJ3tbY5_",
      "type": "text",
      "x": 149.18939728438852,
      "y": 340.24936973064405,
      "width": 431.6596984863281,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3h",
      "roundness": null,
      "seed": 686173072,
      "version": 388,
      "versionNonce": 1456854384,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790660699750,
      "created": 1790660419562,
      "link": null,
      "locked": false,
      "text": "1. Functional Requirements:\n- User should be able to search flights\n  based on arrival and destination and date\n- User should able to login application\n- Select the flight based on time/preference\n- Make payment in your application\n- Confirmation mail/notification",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Functional Requirements:\n- User should be able to search flights\n  based on arrival and destination and date\n- User should able to login application\n- Select the flight based on time/preference\n- Make payment in your application\n- Confirmation mail/notification",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "HQyWJM85iod_FmeoBvp8Z",
      "type": "text",
